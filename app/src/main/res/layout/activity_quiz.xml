<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#3A8C9E"
    android:padding="12dp">

    <!-- Ícones de ajuda e configurações -->
    <ImageButton
        android:id="@+id/btnVoltar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_arrow_back"
        android:contentDescription="Ajuda"
        app:tint="@android:color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/btnConfig"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_config"
        android:contentDescription="Configurações"
        app:tint="@android:color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Header com tema -->
    <TextView
        android:id="@+id/txtTemaQuiz"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:padding="8dp"
        android:text="GERAL"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Caixa branca para a pergunta -->
    <ScrollView
        android:id="@+id/scrollPergunta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/txtTemaQuiz"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtTextoBase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_title"
            android:gravity="center"
            android:padding="16dp"
            android:text="Tabelas numéricas organizadas em linhas e colunas que permitem representar e resolver sistemas lineares, além de modelar fenômenos em diversas áreas. São muito utilizadas em computação e estatística."
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />
    </ScrollView>

    <!-- GRID DAS RESPOSTAS -->
    <HorizontalScrollView
        android:id="@+id/scrollGridRespostasHorizontal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:scrollbars="none"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/scrollPergunta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tecladoLayout"
        app:layout_constraintWidth_percent="1.0">

        <ScrollView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center">

                <androidx.gridlayout.widget.GridLayout
                    android:id="@+id/gridRespostas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp" />
            </LinearLayout>
        </ScrollView>
    </HorizontalScrollView>

    <!-- TECLADO  -->
    <HorizontalScrollView
        android:id="@+id/tecladoLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="1.0">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">

            <!-- Linha 1: Q W E R T Y U I O P -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaStyle"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="Q" />

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaStyle"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="W" />

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaStyle"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="E" />

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaStyle"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="R" />

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaStyle"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="T" />

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaStyle"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="Y" />

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaStyle"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="U" />

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaStyle"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="I" />

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaStyle"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="O" />

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaStyle"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="P" />
            </LinearLayout>

            <!-- Linha 2: A S D F G H J K L -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaStyle"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="A" />

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaStyle"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="S" />

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaStyle"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="D" />

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaStyle"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="F" />

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaStyle"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="G" />

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaStyle"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="H" />

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaStyle"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="J" />

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaStyle"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="K" />

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaStyle"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="L" />
            </LinearLayout>

            <!-- Linha 3: Z X C V B N M ENTER delete-->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaStyle"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="Z" />

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaStyle"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="X" />

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaStyle"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="C" />

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaStyle"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="V" />

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaStyle"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="B" />

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaStyle"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="N" />

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaStyle"
                    android:layout_width="42dp"
                    android:layout_height="48dp"
                    android:text="M" />

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaEspecialStyle"
                    android:layout_width="65dp"
                    android:layout_height="48dp"
                    android:text="ENTER" />

                <com.google.android.material.button.MaterialButton
                    style="@style/TeclaEspecialStyle"
                    android:layout_width="65dp"
                    android:layout_height="48dp"
                    android:text="⌫" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>