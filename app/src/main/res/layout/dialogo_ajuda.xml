<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📘 Como jogar"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Texto explicativo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Leia o texto base e tente adivinhar a resposta. Após cada tentativa, o aplicativo mostrará o quanto sua resposta está próxima da correta:"
            android:textSize="16sp"
            android:textColor="#000000"
            android:layout_marginBottom="20dp" />

        <!-- Exemplo: Resposta Correta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#C8E6C9"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:clipToOutline="true">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="✓"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_circle_green" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="12dp"
                android:text="A letra faz parte da palavra e está na posição correta."
                android:textColor="#000000"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Exemplo: Resposta Parcial -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/colorSecondary"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:clipToOutline="true">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="~"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_circle_laranja" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="12dp"
                android:text="A letra faz parte da palavra mas em outra posição."
                android:textColor="#000000"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Exemplo: Resposta Incorreta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/cinza_tecla"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:clipToOutline="true">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="✗"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_circle_cinza" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="12dp"
                android:text="A letra não faz parte da palavra."
                android:textColor="#000000"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- MODOS DE JOGO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MODOS DE JOGO DISPONÍVEIS:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="12dp" />

        <!-- Nível Fácil -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• FÁCIL - Ideal para aprendizado\n  6 tentativas por pergunta"
            android:textSize="14sp"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <!-- Nível Médio -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• MÉDIO - Para quem já conhece o conteúdo\n  3 tentativas por pergunta"
            android:textSize="14sp"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <!-- Nível Difícil -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• DIFÍCIL - Desafio máximo!\n  Apenas 1 tentativa"
            android:textSize="14sp"
            android:textColor="#000000"
            android:layout_marginBottom="16dp" />

        <!-- Rodapé -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Uma nova pergunta a cada rodada."
            android:textSize="15sp"
            android:textColor="#000000"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>